# Voice Calendar Agent (Electron) talks only to voice-backend.
# Google OAuth, Gemini and Piper now live on the server: do NOT put their secrets here.
# The app reads only VOICE_BACKEND_* keys from this file; real environment variables take precedence.

# voice-backend origin (the app calls <URL>/api/v1). Default: http://localhost:4000
VOICE_BACKEND_URL=http://localhost:4000

# Optional, development servers only (AUTH_DEV_LOGIN_ENABLED=true): shows a "Đăng nhập dev" button
# that signs in with this email without Google and uses the server-side local calendar.
# VOICE_BACKEND_DEV_EMAIL=dev@example.com
